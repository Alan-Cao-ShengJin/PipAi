# Provider-adapter configuration reference for future broker-backed research.
# No live research CLI is currently exposed. Offline demos need no credentials.
# Keep real keys out of source control and chat. No model is selected implicitly.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Connection checks only for now. Do not enable inference without a new spending instruction.
PIP_MODEL_MODE=connection-only
PIP_MODEL=
# Integer micro-US dollars. 1,000,000 = US$1.
# Persisted allowances cannot be increased by editing these variables.
PIP_TENANT_BUDGET_MICROS=1000000
PIP_RUN_BUDGET_MICROS=200000
PIP_MODEL_CALL_BOUND_MICROS=50000
# The call bound is a reservation, not a provider-enforced billing guarantee.
