# Copy to .env.harness for the opt-in local research worker.
# Keep the real key out of source control and chat. No model is selected implicitly.
OPENROUTER_API_KEY=
PIP_MODEL=
# Integer micro-US dollars. 1,000,000 = US$1.
# Persisted allowances cannot be increased by editing these variables.
PIP_TENANT_BUDGET_MICROS=1000000
PIP_RUN_BUDGET_MICROS=200000
PIP_MODEL_CALL_BOUND_MICROS=50000
# The call bound is a reservation, not a provider-enforced billing guarantee.
